# Public browser-safe Supabase values from Project Settings -> API / Connect.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public canonical app origin. Use the production Vercel URL after deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The local provider requires no key. External providers are intentionally disabled.
AI_PROVIDER=local
