# Public browser-safe Supabase values from Project Settings -> API / Connect.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public canonical app origin, also used for Auth confirmation/resend callbacks.
# Set per environment (local, Vercel, custom domain); origin only, no path/query.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local remains active and requires no AI key or privileged admission credential.
# Missing AI_PROVIDER defaults to local in every environment.
# Explicit empty/unsupported values fail safely; they never silently select local.
AI_PROVIDER=local

# Server-only OpenAI foundation; no live mode until separately approved/configured.
# Explicit openai requires BOTH values and the privileged admission configuration below.
# This is a planned model example, not an enabled service. Never use NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# SERVER-ONLY SECRET for the three real-AI admission RPCs. Local does not need it.
# NEVER prefix with NEXT_PUBLIC_. NEVER commit the real value.
# Leave empty until separately approved owner credential setup; no live AI is enabled here.
SUPABASE_SERVICE_ROLE_KEY=
